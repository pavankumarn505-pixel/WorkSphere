
from datetime import date, datetime
from typing import Optional

from sqlalchemy import (
    Column,
    Date,
    DateTime,
    ForeignKey,
    Integer,
    String,
    UniqueConstraint,
)

from app.database import Base


class Attendance(Base):
    __tablename__ = "attendance"

    # Only one attendance record per employee per date.
    __table_args__ = (
        UniqueConstraint(
            "employee_id",
            "date",
            name="uq_attendance_employee_date",
        ),
    )

    # Unique attendance record ID.
    id = Column(Integer, primary_key=True, index=True)

    # Employee this attendance record belongs to.
    employee_id = Column(
        Integer,
        ForeignKey("employees.id"),
        nullable=False,
        index=True,
    )

    # Employee's check-in time.
    check_in = Column(DateTime, nullable=True)

    # Employee's check-out time.
    check_out = Column(DateTime, nullable=True)

    # Attendance date.
    date = Column(Date, nullable=False, index=True)

    # PRESENT, ABSENT, or HALF_DAY.
    status = Column(
        String(20),
        nullable=False,
        default="PRESENT",
    )

    @property
    def working_hours(self) -> Optional[float]:
        """Calculate working hours after check-out."""

        if self.check_in is None or self.check_out is None:
            return None

        seconds = (
            self.check_out - self.check_in
        ).total_seconds()

        return round(seconds / 3600, 2)
